# CODIGO INTERMEDIO DE TRES DIRECCIONES - TINY
# Extension didactica: NO es una salida original del compilador de Louden.
# Los temporales t1, t2... y etiquetas L1, L2... son simbolicos.

read x
t1 = 0 < x
if_false t1 goto L1
label L2
t2 = x < 2
if_false t2 goto L3
write x
goto L4
label L3
write 99
label L4
t3 = x - 1
x = t3
t4 = x == 0
if_false t4 goto L2
goto L5
label L1
write 0
label L5
halt
